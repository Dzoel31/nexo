# ==========================================
# NEXO ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# Bot Core & Discord Token
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
PORT=8000
HOST="0.0.0.0"

# Security & GitHub Webhook Verification (HMAC SHA-256)
GITHUB_SECRET="your_github_webhook_hmac_secret_here"

# Discord Channel IDs Routing
WEBHOOK_DEVLOGS_CHANNEL_ID=1465663504827682848        # Fallback Channel ID (e.g. #dev-logs)
WEBHOOK_RELEASE_NOTES_CHANNEL_ID=1465665336404873241   # Global Release Broadcast Channel ID (#release-notes)
WELCOME_AND_RULES_CHANNEL_ID=1465662834540023920      # Welcome & Rules Channel ID

# LLM & MCP Integration
LLAMA_SERVER_URL="http://localhost:9090/v1/chat/completions"
MCP_SERVER_URL="http://localhost:8000"

# Optional Docker Compose Paths Fallback (JSON or Semicolon Separated)
# DOCKER_COMPOSE_PATHS='{"smart-hydroponic": "/home/admin-iot/smart-hydroponic"}'
