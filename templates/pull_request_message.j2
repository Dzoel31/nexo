{% set content_text = "🚀 **GitHub Pull Request Notification**\nRepo: **" ~ data.repository.full_name ~ "** | Branch: `" ~ data.pull_request.head.ref ~ "`" ~ ("\n<@&" ~ config.discord_role_id ~ ">" if config.discord_role_id else "") %}
{% set pr_desc = (data.pull_request.body | compact_markdown if data.pull_request.body else 'No PR description provided.') | truncate(2000) %}
{% set desc_header = "Pull Request **#" ~ data.number ~ "** has been **" ~ data.action ~ "** by **" ~ data.pull_request.user.login ~ "**.\n\n**📝 Title:** " ~ data.pull_request.title ~ "\n\n**📄 Description:**\n" ~ pr_desc %}
{
  "content": {{ content_text | tojson }},
  "embeds": [
    {
      "title": {{ ("🔍 Pull Request #" ~ data.number ~ ": " ~ (data.pull_request.title | truncate(80))) | tojson }},
      "url": {{ (data.pull_request.html_url | string) | tojson }},
      "description": {{ desc_header | tojson }},
      "color": {% if data.action == "opened" or data.action == "reopened" %}3066993{% elif data.action == "edited" %}15105570{% elif data.action == "closed" and data.pull_request.merged_at %}7291585{% elif data.action == "closed" %}9807270{% else %}2899536{% endif %},
      "author": {
        "name": {{ data.pull_request.user.login | tojson }},
        "icon_url": {{ (data.pull_request.user.avatar_url | string) | tojson }}
      },
      "fields": [
        {"name": "Repository", "value": {{ data.repository.full_name | tojson }}, "inline": true},
        {"name": "Branch", "value": {{ ("`" ~ data.pull_request.head.ref ~ "` ➔ `" ~ data.pull_request.base.ref ~ "`") | tojson }}, "inline": true},
        {"name": "Action Status", "value": {{ (data.action | capitalize) | tojson }}, "inline": true},
        {"name": "Lines Changed", "value": {{ ("🟢 +" ~ (data.pull_request.additions or 0) ~ " | 🔴 -" ~ (data.pull_request.deletions or 0)) | tojson }}, "inline": true},
        {"name": "Total Commits", "value": {{ ((data.pull_request.commits or 0) | string) | tojson }}, "inline": true},
        {"name": "Files Changed", "value": {{ ((data.pull_request.changed_files or 0) | string) | tojson }}, "inline": true}
      ],
      "thumbnail": {"url": {{ (data.pull_request.user.avatar_url | string) | tojson }}},
      "footer": {
        "text": "Nexo GitHub Service • KSM AIoT"
      },
      "timestamp": {{ (data.pull_request.updated_at | default('') | string) | tojson }}
    }
  ],
  "components": [
    {
      "type": 1,
      "components": [
        {
          "type": 2,
          "style": 5,
          "label": "Review Pull Request",
          "url": {{ (data.pull_request.html_url | string) | tojson }},
          "emoji": {
            "name": "🔍"
          }
        },
        {
          "type": 2,
          "style": 5,
          "label": "View Diff Files",
          "url": {{ ((data.pull_request.html_url | string) ~ "/files") | tojson }},
          "emoji": {
            "name": "📂"
          }
        }
      ]
    }
  ]
}
