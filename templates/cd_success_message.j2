{% set content_text = config.emoji ~ " **" ~ config.title ~ "**" ~ ("\n<@&" ~ config.discord_role_id ~ ">" if config.discord_role_id else "") %}
{% set target_url = data.release.html_url if data.release and data.release.html_url else (data.workflow_run.html_url if data.workflow_run and data.workflow_run.html_url else data.repository.html_url) %}
{% set trigger_name = data.release.tag_name if data.release and data.release.tag_name else (data.workflow_run.name if data.workflow_run else 'Continuous Delivery') %}
{% set desc_intro = "Service **" ~ data.repository.name ~ "** has been successfully deployed to VPS via **" ~ trigger_name ~ "**." %}
{% if data.release and data.release.body %}
  {% set notes = (data.release.body | compact_markdown | truncate(2000)) %}
  {% set desc_text = desc_intro ~ "\n\n**📝 Release Notes:**\n" ~ notes %}
{% elif data.workflow_run and data.workflow_run.head_commit and data.workflow_run.head_commit.message %}
  {% set notes = (data.workflow_run.head_commit.message | compact_markdown | truncate(1000)) %}
  {% set desc_text = desc_intro ~ "\n\n**📝 Deployed Changes:**\n```text\n" ~ notes ~ "\n```" %}
{% elif data.workflow_run and data.workflow_run.display_title %}
  {% set desc_text = desc_intro ~ "\n\n**📝 Changes:** `" ~ data.workflow_run.display_title ~ "`" %}
{% else %}
  {% set desc_text = desc_intro %}
{% endif %}
{% set trigger_actor = data.release.author.login if data.release and data.release.author else (data.workflow_run.triggering_actor.login if data.workflow_run and data.workflow_run.triggering_actor else (data.sender.login if data.sender else 'System')) %}
{
  "content": {{ content_text | tojson }},
  "embeds": [
    {
      "title": {{ (config.emoji ~ " " ~ config.title ~ " — " ~ data.repository.full_name) | tojson }},
      "url": {{ (target_url | string) | tojson }},
      "color": 3066993,
      "description": {{ desc_text | tojson }},
      "fields": [
        {"name": "Repository", "value": {{ data.repository.full_name | tojson }}, "inline": true},
        {"name": "Triggered By", "value": {{ trigger_actor | tojson }}, "inline": true},
        {"name": "VPS Status", "value": "✅ Deployed Successfully", "inline": true}
        {% if data.workflow_run and data.workflow_run.head_branch %}
        ,{"name": "Branch / Tag", "value": {{ ("`" ~ data.workflow_run.head_branch ~ "`") | tojson }}, "inline": true}
        {% elif data.release and data.release.tag_name %}
        ,{"name": "Branch / Tag", "value": {{ ("`" ~ data.release.tag_name ~ "`") | tojson }}, "inline": true}
        {% endif %}
        {% if data.workflow_run and data.workflow_run.head_sha %}
        ,{"name": "Commit SHA", "value": {{ ("`" ~ data.workflow_run.head_sha[:7] ~ "`") | tojson }}, "inline": true}
        {% endif %}
      ],
      "footer": {
        "text": "Nexo CD Pipeline Service • KSM AIoT"
      }
    }
  ],
  "components": [
    {
      "type": 1,
      "components": [
        {
          "type": 2,
          "style": 5,
          "label": "View on GitHub",
          "url": {{ (target_url | string) | tojson }},
          "emoji": {
            "name": "🌐"
          }
        },
        {
          "type": 2,
          "style": 5,
          "label": "Repository",
          "url": {{ (data.repository.html_url | string) | tojson }},
          "emoji": {
            "name": "📂"
          }
        }
      ]
    }
  ]
}
