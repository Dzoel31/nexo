{
  "content": "📚 **Dokumentasi Baru Diperbarui!**{% if config.discord_role_id %}\n<@&{{ config.discord_role_id }}>{% endif %}",
  "embeds": [
    {
      "title": "📚 Dokumentasi {{ data.repository.name }} Diperbarui",
      "url": "{{ data.repository.homepage if data.repository.homepage else (data.release.html_url if data.release and data.release.html_url else data.repository.html_url) }}",
      "color": 3447003,
      "description": "Dokumentasi **{{ data.repository.name }}** telah berhasil dipublikasikan melalui **{{ data.workflow_run.name if data.workflow_run else 'Deploy Documentation' }}**.\n{% if data.release and data.release.body %}\n\n**Catatan Perubahan Dokumentasi:**\n```markdown\n{{ data.release.body }}\n```{% elif data.workflow_run and data.workflow_run.display_title %}\n\n**Pembaruan:** {{ data.workflow_run.display_title }}{% endif %}",
      "fields": [
        {"name": "Repo", "value": "{{ data.repository.full_name }}", "inline": true},
        {"name": "Triggered By", "value": "{{ data.workflow_run.triggering_actor.login if data.workflow_run and data.workflow_run.triggering_actor else (data.sender.login if data.sender else 'System') }}", "inline": true},
        {"name": "Status", "value": "✅ Sukses (Live)", "inline": true}
      ],
      "footer": {
        "text": "Nexo Documentation Service • KSM AIoT"
      }
    }
  ]
}
